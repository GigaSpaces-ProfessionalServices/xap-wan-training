<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gigaspaces.wan.training</groupId>
    <artifactId>BillBuddyGateway</artifactId>
    <packaging>jar</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>BillBuddyGateway</name>
    <parent>
        <groupId>com.gigaspaces.wan.training</groupId>
        <artifactId>lab06-solution</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <dependencies>
        <dependency>
            <groupId>com.gigaspaces.wan.training</groupId>
            <artifactId>BillBuddyModel</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <!-- Needed to compile against GatewayDelegatorFactoryBean/GatewaySinkFactoryBean/etc.
             now that they're referenced from real Java (GatewayBeansConfig), not just XML text
             resolved at deploy time. Scope "provided" (not "compile", unlike the standalone
             clients ModifyGatewayTarget/AdminBootStrap/BillBuddyAccountFeeder): this module
             deploys INTO a GSC, whose own full-distribution classpath already supplies these
             classes at runtime - bundling them into this jar would risk classpath duplication
             against the GSC's own copy. Matches the reactor's existing xap-openspaces dependency,
             which is "provided" for the same reason. -->
        <dependency>
            <groupId>com.gigaspaces</groupId>
            <artifactId>xap-admin</artifactId>
            <version>${gigaspaces.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>BillBuddyGateway</finalName>
    </build>
</project>
