<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gigaspaces.wan.training</groupId>
    <artifactId>wan-distribution</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>wan-distribution</name>
    <parent>
        <groupId>com.gigaspaces.wan.training</groupId>
        <artifactId>wan-active-active-on-nodes</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <!-- No source of its own - depending on the other 3 modules here is what
         forces the reactor to build them before this one, so the assembly
         below always bundles freshly-built jars, never stale ones. -->
    <dependencies>
        <dependency>
            <groupId>com.gigaspaces.wan.training</groupId>
            <artifactId>wan-space</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gigaspaces.wan.training</groupId>
            <artifactId>wan-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gigaspaces.wan.training</groupId>
            <artifactId>wan-feeder</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <finalName>wan-gateway-node</finalName>
                    <descriptors>
                        <descriptor>src/assembly/dist.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
