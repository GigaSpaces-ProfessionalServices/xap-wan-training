<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:os-sla="http://www.openspaces.org/schema/sla"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.openspaces.org/schema/sla http://www.openspaces.org/schema/sla/openspaces-sla.xsd">

    <!-- 2 partitions x 1 backup = 4 instances, matching the 4 space GSCs the
         blueprint-generated start-grid script launches on each node. -->
    <os-sla:sla cluster-schema="partitioned" number-of-instances="2" number-of-backups="1"
                max-instances-per-vm="1">
    </os-sla:sla>
</beans>
