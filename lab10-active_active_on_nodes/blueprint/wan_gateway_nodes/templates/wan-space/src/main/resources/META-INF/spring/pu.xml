<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:os-core="http://www.openspaces.org/schema/core"
       xmlns:os-gateway="http://www.openspaces.org/schema/core/gateway"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.openspaces.org/schema/core http://www.openspaces.org/schema/core/openspaces-core.xsd
       http://www.openspaces.org/schema/core/gateway http://www.openspaces.org/schema/core/gateway/openspaces-gateway.xsd">

    <!-- One shared module, deployed once per site (node) with different -p overrides -
         no per-site copy of this jar. Defaults below are only used if a value isn't
         passed at deploy time; the blueprint-generated deploy scripts always pass one. -->
    <bean id="propertiesConfigurer" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="ignoreResourceNotFound" value="true" />
        <property name="properties">
            <props>
                <prop key="localSpaceName">wanSpaceUS</prop>
                <prop key="localGatewayName">US</prop>
                <prop key="remoteGatewayName">EMEA</prop>
            </props>
        </property>
    </bean>

    <os-core:distributed-tx-manager id="transactionManager" />

    <os-core:embedded-space id="space" space-name="${localSpaceName}" mirrored="false" gateway-targets="gatewayTargets" />
    <os-core:giga-space id="gigaSpace" space="space" tx-manager="transactionManager" />

    <os-gateway:targets id="gatewayTargets" local-gateway-name="${localGatewayName}">
        <os-gateway:target name="${remoteGatewayName}" />
    </os-gateway:targets>
</beans>
